# Required: Google Gemini API Key
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY = YOUR_GEMINI_API_KEY_HERE

# Optional: OpenRouter API Key (if switching provider in src/ai/client.ts)
OPENROUTER_API_KEY=#Not required

# Search provider: tavily, duckduckgo, or mock
# If omitted, Tavily is used when an API key is available; otherwise DuckDuckGo
# SEARCH_PROVIDER=duckduckgo

# Optional: Tavily API key (not required for DuckDuckGo or Mock)
TAVILY_API_KEY=

# Optional: Legacy search API key used by the Tavily provider
SEARCH_API_KEY=
